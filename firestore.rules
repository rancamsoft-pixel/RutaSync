rules_version = '2';

// RutaSync (RutaBanano) — Reglas Oficiales de Sincronización Cloud Firestore
// Permite sincronización offline-first idempotente (lectura y escritura de documentos)
// tanto en colecciones raíz como en la estructura aislada por negocio (/businesses/{businessId}/...)

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
