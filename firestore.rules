rules_version = '2';

// RutaSync (RutaBanano) — Reglas Oficiales de Seguridad en Servidor (Cloud Firestore)
// Soporta colecciones de primer nivel (/users, /roles, /products, /suppliers, /clients,
// /shifts, /operations, /editAuthorizations, /closures, /postClosureAdjustments, /auditLogs)
// y colecciones aisladas por negocio (/businesses/{businessId}/...).

service cloud.firestore {
  match /databases/{database}/documents {

    function userExistsAndActiveRoot(userId) {
      return userId is string &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.active == true;
    }

    function userExistsAndActiveTenant(businessId, userId) {
      return (userId is string &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(userId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/users/$(userId)).data.active == true) ||
        userExistsAndActiveRoot(userId);
    }

    function userIsOwnerTenant(businessId, userId) {
      return (userExistsAndActiveTenant(businessId, userId) &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(userId)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/users/$(userId)).data.role == 'OWNER') ||
        (userExistsAndActiveRoot(userId) &&
        get(/databases/$(database)/documents/users/$(userId)).data.role == 'OWNER');
    }

    // =========================================================================
    // COLECCIONES DE PRIMER NIVEL (Visibles directamente en Consola Firestore)
    // =========================================================================

    match /roles/{roleId} {
      allow read: if true;
      allow create, update: if roleId in ['OWNER', 'HELPER'];
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.role in ['OWNER', 'HELPER'];
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /shifts/{shiftId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['OPEN', 'CLOSED'];
      allow update: if resource.data.status == 'OPEN';
      allow delete: if false;
    }

    match /operations/{operationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /editAuthorizations/{authId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /closures/{closureId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /postClosureAdjustments/{adjustmentId} {
      allow read: if true;
      allow create: if request.resource.data.reason is string && request.resource.data.reason.size() >= 5;
      allow update, delete: if false;
    }

    match /auditLogs/{auditId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // =========================================================================
    // COLECCIONES POR NEGOCIO (/businesses/{businessId}/...)
    // =========================================================================

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update: if request.resource.data.businessId == businessId;
      allow delete: if false;

      match /roles/{roleId} {
        allow read: if true;
        allow create, update: if roleId in ['OWNER', 'HELPER'];
        allow delete: if false;
      }

      match /users/{userId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId &&
          request.resource.data.role in ['OWNER', 'HELPER'];
        allow delete: if false;
      }

      match /products/{productId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId;
        allow delete: if false;
      }

      match /suppliers/{supplierId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId;
        allow delete: if false;
      }

      match /clients/{clientId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId;
        allow delete: if false;
      }

      match /shifts/{shiftId} {
        allow read: if true;
        allow create: if request.resource.data.businessId == businessId &&
          request.resource.data.status in ['OPEN', 'CLOSED'];
        allow update: if resource.data.status == 'OPEN';
        allow delete: if false;
      }

      match /operations/{operationId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId;
        allow delete: if false;
      }

      match /editAuthorizations/{authId} {
        allow read: if true;
        allow create, update: if request.resource.data.businessId == businessId;
        allow delete: if false;
      }

      match /closures/{closureId} {
        allow read: if true;
        allow create: if request.resource.data.businessId == businessId;
        allow update, delete: if false;
      }

      match /postClosureAdjustments/{adjustmentId} {
        allow read: if true;
        allow create: if request.resource.data.businessId == businessId &&
          userIsOwnerTenant(businessId, request.resource.data.authorizerId) &&
          request.resource.data.reason is string &&
          request.resource.data.reason.size() >= 5;
        allow update, delete: if false;
      }

      match /auditLogs/{auditId} {
        allow read: if true;
        allow create: if request.resource.data.businessId == businessId;
        allow update, delete: if false;
      }
    }
  }
}
